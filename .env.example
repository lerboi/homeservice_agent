# ============================================================
# Voco — Environment Variables
# ============================================================
# Copy to `.env.local` and fill in. Vars under REQUIRED are validated at
# server boot by src/lib/env.js — a missing one throws in production and
# warns in dev. Everything else is optional (a missing value degrades a
# single feature, not the whole app).
#
# NEXT_PUBLIC_* vars are exposed to the browser bundle — never put secrets
# behind that prefix.

# ------------------------------------------------------------
# Core — REQUIRED (validated by src/lib/env.js)
# ------------------------------------------------------------

# Supabase (Auth + Postgres + RLS + Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute base URL of the deployed app (used for OAuth callbacks, Stripe
# redirect URLs, email links). e.g. https://app.voco.live
NEXT_PUBLIC_APP_URL=

# Stripe — billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twilio — SIP trunking + SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# LiveKit — voice agent media + outbound SIP test call
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Resend — transactional email
RESEND_API_KEY=

# Shared secret guarding /api/cron/* endpoints (Vercel Cron Authorization)
CRON_SECRET=

# ------------------------------------------------------------
# Twilio — optional (provisioning + outbound SMS sender)
# ------------------------------------------------------------
# Elastic SIP trunk SID. Used as the legacy/fallback routing path (AI-direct)
# when RAILWAY_WEBHOOK_URL is unset, and as the trunk newly provisioned numbers
# are removed FROM when webhook routing is active (the Stripe webhook + the
# scripts/cutover-existing-numbers.js migration both disassociate it).
TWILIO_SIP_TRUNK_SID=
# Default From number for outbound SMS (notifications, reminders, recovery).
TWILIO_FROM_NUMBER=

# Base URL of the livekit-agent FastAPI webhook on Railway (no trailing slash),
# e.g. https://voco-agent.up.railway.app. When set, provisioning routes new
# numbers to <RAILWAY_WEBHOOK_URL>/twilio/incoming-call (enabling owner-pickup,
# VIP routing, the working-hours schedule, and the outbound-minute cap) and
# removes them from the SIP trunk. When unset, provisioning falls back to
# trunk-only AI-direct routing. MUST be set in Vercel production to enable the
# full routing stack for new tenants.
RAILWAY_WEBHOOK_URL=

# ------------------------------------------------------------
# LiveKit — optional (test call)
# ------------------------------------------------------------
# Outbound SIP trunk ID used by the onboarding/settings test call.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# ------------------------------------------------------------
# Resend — optional sender override
# ------------------------------------------------------------
# From address for outbound email. Falls back to noreply@voco.live.
RESEND_FROM_EMAIL=

# ------------------------------------------------------------
# Stripe price IDs — optional (per-plan, monthly / annual / overage)
# ------------------------------------------------------------
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_STARTER_OVERAGE=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_GROWTH_OVERAGE=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_SCALE_ANNUAL=
STRIPE_PRICE_SCALE_OVERAGE=

# ------------------------------------------------------------
# Google Calendar — optional (OAuth sync)
# ------------------------------------------------------------
# Redirect URI: $NEXT_PUBLIC_APP_URL/api/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# Outlook / Microsoft Calendar — optional (OAuth sync)
# ------------------------------------------------------------
# Redirect URI: $NEXT_PUBLIC_APP_URL/api/outlook-calendar/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Validation token for the Outlook calendar push webhook.
OUTLOOK_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Xero integration — optional (REST, xero-node SDK)
# ------------------------------------------------------------
# Register at developer.xero.com
# Redirect URI: $NEXT_PUBLIC_APP_URL/api/integrations/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Xero webhook signing key — assigned by Xero when you subscribe a webhook URL
# at https://developer.xero.com/myapps -> {app} -> Webhooks. Required by
# /api/webhooks/xero for HMAC-SHA256 signature verification.
XERO_WEBHOOK_KEY=

# ------------------------------------------------------------
# Jobber integration — optional (GraphQL, graphql-request)
# ------------------------------------------------------------
# Register at developer.getjobber.com
# Redirect URI: $NEXT_PUBLIC_APP_URL/api/integrations/jobber/callback
# Scopes configured in the Developer Center (not passed as a query param)
JOBBER_CLIENT_ID=
# Jobber webhook HMAC signature key IS JOBBER_CLIENT_SECRET (not a separate
# secret). /api/webhooks/jobber reads JOBBER_CLIENT_SECRET directly to verify
# X-Jobber-Hmac-SHA256.
# Reference: developer.getjobber.com/docs/using_jobbers_api/setting_up_webhooks/
JOBBER_CLIENT_SECRET=

# ------------------------------------------------------------
# AI / LLM — optional
# ------------------------------------------------------------
# Groq — triage layer 2, dashboard chat, public chat.
GROQ_API_KEY=
# Gemini — invoice line-item description generation.
GEMINI_API_KEY=

# ------------------------------------------------------------
# ElevenLabs — optional (demo voice preview on landing/marketing)
# ------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_AI=

# ------------------------------------------------------------
# Contact form recipients — optional (Resend routing)
# ------------------------------------------------------------
CONTACT_EMAIL_SALES=
CONTACT_EMAIL_SUPPORT=
CONTACT_EMAIL_PARTNERSHIPS=
# Fallback recipient when the inquiry type has no dedicated address.
CONTACT_EMAIL_FALLBACK=

# ------------------------------------------------------------
# Sentry — optional (error + performance monitoring)
# ------------------------------------------------------------
# Browser client init reads NEXT_PUBLIC_SENTRY_DSN; server/edge init reads
# SENTRY_DSN. Set both for full coverage.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source map upload / release config (build-time, withSentryConfig).
SENTRY_ORG=
SENTRY_PROJECT=
# Shared secret guarding the /api/debug/test-error endpoint.
SENTRY_TEST_SECRET=

# ------------------------------------------------------------
# Dev / ops — optional
# ------------------------------------------------------------
# Comma-separated list of additional allowed dev origins (next.config.js).
NEXT_ALLOWED_DEV_ORIGINS=
# Set to 'true' to enable verbose proxy debug logging (no PII).
PROXY_DEBUG=
